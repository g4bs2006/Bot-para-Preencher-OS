# ------------------------------------------------------------------------------
# Configurações de Acesso ao Neovero
# Copie este arquivo para '.env' na raiz do projeto e preencha as suas credenciais.
# ------------------------------------------------------------------------------

# URL do portal de login do Neovero (ex: https://orbis.neovero.com/login)
NEOVERO_URL="https://orbis.neovero.com/login"

# Seu nome de usuário/login de acesso ao Neovero
NEOVERO_USER="seu_usuario_aqui"

# Sua senha de acesso ao Neovero
NEOVERO_PASS="sua_senha_aqui"
